{
  "name": "@gaialabs/core",
  "version": "0.2.5",
  "description": "GaiaLabs TypeScript Core Library - Universal ROM processing engine",
  "funding": "https://github.com/sponsors/Azarem",
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "module": "dist/index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "client",
    "prisma.cjs",
    "prisma.mjs",
    "prisma.d.ts",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -p \"'export const CORE_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "build": "tsdown",
    "prisma:generate": "prisma generate",
    "dev": "tsdown --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "publish": "tsdown && npm publish --access public"
  },
  "dependencies": {
    "@prisma/client": "^7.6.0",
    "@supabase/supabase-js": "^2.55.0"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "@types/node": "^20.19.29",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "prisma": "^7.6.0",
    "tsdown": "^0.20.0-beta.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./prisma": {
      "types": "./prisma.d.ts",
      "import": "./prisma.mjs",
      "require": "./prisma.cjs",
      "default": "./prisma.cjs"
    }
  },
  "keywords": [
    "rom-hacking",
    "typescript",
    "web-workers",
    "nodejs",
    "browser",
    "universal"
  ],
  "author": "GaiaLabs Team",
  "license": "MIT"
}
