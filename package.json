{
  "name": "@gaialabs/core",
  "version": "1.0.5",
  "description": "GaiaLabs TypeScript Core Library - Universal ROM processing engine",
  "funding": "https://github.com/sponsors/Azarem",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "module": "dist/index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -p \"'export const CORE_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "convert-midi": "node scripts/iog-to-midi.ts",
    "publish": "tsdown && npm publish --access public"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "keywords": [
    "rom-hacking",
    "typescript",
    "web-workers",
    "nodejs",
    "browser",
    "universal"
  ],
  "author": "GaiaLabs Team",
  "license": "MIT"
}
